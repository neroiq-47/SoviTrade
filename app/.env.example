# Browser-side Solana RPC (must allow CORS). Leave unset to use the built-in /api/rpc proxy.
NEXT_PUBLIC_SOLANA_RPC=
# RPC used by the /api/rpc proxy (default https://api.mainnet-beta.solana.com)
SOLANA_RPC_URL=
# Pyth Hermes (prices need a key since 26 Aug 2026)
PYTH_API_KEY=
PYTH_HERMES_URL=https://pyth.dourolabs.app/hermes
# Jupiter (default https://lite-api.jup.ag, keyless)
JUPITER_API_URL=
# Sentry (DSNs are public identifiers)
NEXT_PUBLIC_SENTRY_DSN=https://e1d3c383ed530fd86e9dbf16e4f23893@o4512260171104256.ingest.de.sentry.io/4512260183556176
SENTRY_DSN=https://e1d3c383ed530fd86e9dbf16e4f23893@o4512260171104256.ingest.de.sentry.io/4512260183556176
# Only needed for source-map upload
SENTRY_AUTH_TOKEN=
# Enables /api/sentry-test?token=...
SENTRY_TEST_TOKEN=
KEEPER_SENTRY_DSN=https://6059fc97767903d3b20d8879304d1cf4@o4512260171104256.ingest.de.sentry.io/4512260183687248
# Keeper. Dry-run is the default. Set KEEPER_DRY_RUN=false only with a cron secret
# and session material supplied out of band. Never commit private keys.
KEEPER_DRY_RUN=true
KEEPER_CRON_SECRET=
JUPITER_SWAP_URL=
JUPITER_API_KEY=
JUPITER_TRIGGER_URL=
